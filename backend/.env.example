# Project Details
PROJECT_NAME="Hybrid RAG Chatbot"
API_V1_STR="/api/v1"

# Relational Database (PostgreSQL)
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123
POSTGRES_PORT=5432
POSTGRES_DB=hybrid_rag

# Caching Store (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Embedding & Provider Configurations
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_VERSION=v1
OPENAI_API_KEY=your_openai_api_key_here

# Security & Authentication (JWT & Cookies)
JWT_SECRET=super_secure_random_development_signing_key_32_bytes_at_least
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Retrieval & Search Configurations
DEFAULT_TOP_K=10
MAX_TOP_K=100
SIMILARITY_THRESHOLD=0.25
VECTOR_COLLECTION_NAME=documents
SEARCH_TIMEOUT=3.0

