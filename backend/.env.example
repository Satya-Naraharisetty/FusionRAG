# Project Details
PROJECT_NAME="Hybrid RAG Chatbot"
API_V1_STR="/api/v1"

# Relational Database (PostgreSQL)
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123
POSTGRES_PORT=5432
POSTGRES_DB=hybrid_rag

# Caching Store (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Security & Authentication (JWT & Cookies)
JWT_SECRET=super_secure_random_development_signing_key_32_bytes_at_least
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
