# ==============================================================================
# Hybrid RAG Chatbot - Environment Variables Template (.env.example)
# ==============================================================================

# Application Environment Profile (development | production)
ENV=development
PROJECT_NAME="Hybrid RAG Chatbot"
API_V1_STR="/api/v1"

# Relational Database (PostgreSQL)
# For local databases:
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hybrid_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# For external databases like Supabase, set DATABASE_URL directly.
# Connection string (recommended to use Supabase transaction pooler port 6543 with ?pgbouncer=true):
# DATABASE_URL=postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Integration-test database (pytest). The test suite truncates tables, so this
# MUST be a dedicated database — never the dev DB. Defaults to the
# `postgres-test` compose service (port 5433, db hybrid_rag_test); set this to
# point pytest anywhere else (e.g. a CI ephemeral instance).
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hybrid_rag_test

# Caching Store (Redis)
# Use REDIS_HOST/REDIS_PORT for local setups, or REDIS_URL for cloud setups (like Upstash).
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=rediss://default:password@endpoint.upstash.io:port

# Vector Database (Qdrant)
# Use QDRANT_HOST/QDRANT_PORT for local setups, or QDRANT_URL/QDRANT_API_KEY for Qdrant Cloud.
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_URL=https://xxxxxx.gcp.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=documents

# Storage Configuration
# Options: database (SQL Blob), local (Disk storage), s3 (S3/MinIO cloud storage)
STORAGE_PROVIDER=database
S3_BUCKET=hybrid-rag-documents

# Dense Vector Embeddings Configuration (Handled by Jina AI)
# Options for EMBEDDING_PROVIDER: jina
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSION=768

# Cross-Encoder Reranker Configuration (Handled by Jina AI)
# Options for RERANKER_PROVIDER: jina | sentence_transformers | none
ENABLE_RERANKER=True
RERANKER_MODEL=jina-reranker-v2-base-multilingual
RERANKER_PROVIDER=jina
RERANKER_DEVICE=cpu
RERANK_TOP_K=5
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
RERANKER_CONCURRENCY_LIMIT=8
JINA_API_KEY=your_jina_api_key_here

# LLM Providers Configuration
# Uses Google Gemini for synthesis, reasoning, and multi-agent planning
LLM_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# ==============================================================================
# Gemini LLM API Keys (Workload Isolation)
# Set the 3 dedicated keys below to avoid rate-limiting (HTTP 429).
# If you only have 1 single Gemini key, you can set GEMINI_API_KEY instead.
# ==============================================================================
GEMINI_LLM_API_KEY=        # [Recommended Key 1] Primary key for Chat, Synthesis streaming, and History rewriting
GEMINI_PLANNER_API_KEY=    # [Recommended Key 2] Dedicated key for MasterAgent planning, DAG generation, and evaluation
GEMINI_FALLBACK_API_KEY=   # [Recommended Key 3] Auto-failover backup key if Key 1 or Key 2 hits rate limits
GEMINI_API_KEY=            # [Optional / Single-key setups only] If set alone, acts as universal key for all roles

# Security, JWT Token, Encryption & Session Cookies
# Generate secure 32+ character keys: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_MASTER_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Default Admin Seeding Credentials (Local dev setup only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Rate Limiting
ENABLE_RATE_LIMITER=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
ACCOUNT_DELETE_RATE_LIMIT_PER_MINUTE=10

# Database migration bypass option (set to true in testing/ci)
SKIP_DB_MIGRATION_CHECK=true

# ==============================================================================
# Google OAuth 2.0
# Create your app at: https://console.cloud.google.com/apis/credentials
# Add Authorized redirect URIs:
#   - http://localhost:8000/api/v1/auth/oauth/google/callback  (local dev)
#   - https://<your-backend>.vercel.app/api/v1/auth/oauth/google/callback  (prod)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# GitHub OAuth 2.0
# Create your app at: https://github.com/settings/developers
# Add Authorization callback URL:
#   - http://localhost:8000/api/v1/auth/oauth/github/callback  (local dev)
#   - https://<your-backend>.vercel.app/api/v1/auth/oauth/github/callback  (prod)
# ==============================================================================
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=

# Base URL of the backend used to build OAuth callback URIs.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Base URL of the frontend — used to redirect after OAuth completes.
FRONTEND_URL=http://localhost:5173

# Production Vercel overrides (set these in Vercel environment variables):
# OAUTH_REDIRECT_BASE_URL=https://hybrid-rag-gilt.vercel.app
# FRONTEND_URL=https://hybrid-rag-frontend.vercel.app
# COOKIE_SECURE=True
# COOKIE_SAMESITE=none
# BACKEND_CORS_ORIGINS=https://hybrid-rag-frontend.vercel.app
# BACKEND_CORS_ORIGIN_REGEX=https://hybrid-rag-frontend.*\.vercel\.app

# ==============================================================================
# Resend Transactional Email (Magic Link)
# Sign up at: https://resend.com
# ==============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ==============================================================================
# Web Search Settings
# Supported providers: auto | serpapi | firecrawl | duckduckgo
# (SerpAPI or Firecrawl provide high-precision results; DuckDuckGo is zero-config)
# ==============================================================================
ENABLE_WEB_SEARCH=true
WEB_SEARCH_PROVIDER=auto
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10.0
