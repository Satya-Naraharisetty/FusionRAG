# Project Details
PROJECT_NAME="Hybrid RAG Chatbot"
API_V1_STR="/api/v1"

# Relational Database (PostgreSQL)
# For local development with Docker:
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123
POSTGRES_PORT=5432
POSTGRES_DB=hybrid_rag

# For external databases like Supabase, set DATABASE_URL directly.
# Supabase Transaction Pooler (Port 6543, recommended for backend query pooling):
# DATABASE_URL=postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase Direct Connection / Session Pooler (Port 5432, recommended for running migrations):
# DATABASE_URL=postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or using direct hostname:
# DATABASE_URL=postgresql://postgres:[password]@db.[username].supabase.co:5432/postgres


# Caching Store (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Embedding & Provider Configurations
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_VERSION=v1
OPENAI_API_KEY=your_openai_api_key_here

# Security & Authentication (JWT & Cookies)
JWT_SECRET=super_secure_random_development_signing_key_32_bytes_at_least
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Retrieval & Search Configurations
DEFAULT_TOP_K=10
MAX_TOP_K=100
SIMILARITY_THRESHOLD=0.25
VECTOR_COLLECTION_NAME=documents
SEARCH_TIMEOUT=3.0

# LLM Orchestration & Answer Generation Configurations
LLM_PROVIDER=gemini
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_CHAT_MODEL=gemini-1.5-flash
TEMPERATURE=0.0
MAX_CONTEXT_TOKENS=4000
MAX_RESPONSE_TOKENS=1000
SYSTEM_PROMPT_PATH=app/core/prompts/system_prompt.txt
SYSTEM_PROMPT_TOKENS=1000
RESERVED_COMPLETION_TOKENS=500
ENABLE_STREAMING=True
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

