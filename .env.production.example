# ==============================================================================
# Hybrid RAG Chatbot - Production Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to create your active production environment file:
#    cp .env.production.example .env.production
# 2. Populate the empty parameters with secure production secrets.
# 3. DO NOT commit the filled .env.production file to Git repositories.
# ==============================================================================

# Application Environment Profile
ENV=production
PROJECT_NAME="Hybrid RAG Chatbot"
API_V1_STR="/api/v1"

# Relational Database (PostgreSQL)
# For local containerized database:
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=hybrid_rag
POSTGRES_USER=postgres_production_user
POSTGRES_PASSWORD=insert_strong_unique_production_db_password_here

# For external databases like Supabase, set DATABASE_URL directly.
# Supabase Transaction Pooler (Port 6543, recommended for backend query pooling):
# DATABASE_URL=postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase Direct Connection / Session Pooler (Port 5432, recommended for running migrations):
# DATABASE_URL=postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or using direct hostname:
# DATABASE_URL=postgresql://postgres:[password]@db.[username].supabase.co:5432/postgres


# Caching Store (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Storage Configuration
# Supported options: database (SQL Blob), local (Disk storage), s3 (S3/MinIO cloud storage)
STORAGE_PROVIDER=database
S3_BUCKET=hybrid-rag-documents
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=

# LLM Providers Configuration
# Supported: gemini | openai
LLM_PROVIDER=gemini
LLM_PROVIDER_BACKUP=openai

# API Keys (Keep these secure!)
GEMINI_API_KEY=your_production_gemini_api_key_here
OPENAI_API_KEY=your_production_openai_api_key_here

# Security, JWT Token & Session Cookies
# Generate a high-entropy secret, e.g., using: openssl rand -hex 32
JWT_SECRET=insert_secure_hex_signing_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=refresh_token
COOKIE_DOMAIN=yourdomain.com
COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# Rate Limiting Hardening
ENABLE_RATE_LIMITER=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Database migration bypass option (set to True in CI/CD pipeline if run separately)
# SKIP_DB_MIGRATION_CHECK=False
